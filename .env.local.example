# Copy this file to .env.local and fill in once your Shopify product exists.
# Until these are set, the site runs with built-in demo data (see lib/shopify/mock-data.ts).

# Settings -> Apps and sales channels -> Develop apps -> create an app ->
# Configure Storefront API scopes -> Install -> Storefront API access token.
SHOPIFY_STOREFRONT_TOKEN=

# your-store.myshopify.com (no https://)
SHOPIFY_STORE_DOMAIN=

# The handle of the bundle product (Products -> your product -> the URL slug
# after /products/). It must have exactly 3 variants, in order: 1 Set, 2 Sets, 3 Sets.
SHOPIFY_PRODUCT_HANDLE=

# Optional — defaults to 2025-10 if omitted.
SHOPIFY_API_VERSION=2025-10
